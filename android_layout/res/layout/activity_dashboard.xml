<?xml version="1.0" encoding="utf-8"?>
<!-- Tugas 2: Dashboard Menu Bobot Seimbang (LinearLayout flat) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- 1 baris berisi 3 tombol dengan lebar sama persis -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnProfil"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="Profil" />

        <Button
            android:id="@+id/btnNilai"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:text="Nilai" />

        <Button
            android:id="@+id/btnJadwal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Jadwal" />
    </LinearLayout>

    <!-- Area catatan: mengisi SISA tinggi layar -->
    <EditText
        android:id="@+id/etCatatan"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:gravity="top|start"
        android:hint="Tulis pesan / catatan di sini..."
        android:inputType="textMultiLine"
        android:padding="12dp" />

</LinearLayout>
